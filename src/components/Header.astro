---
import { withBase } from "../lib/url";

const { current = "" } = Astro.props;

const links = [
  { href: withBase("/"), label: "Home", key: "home" },
  { href: withBase("/services"), label: "Services", key: "services" },
  { href: withBase("/industries"), label: "Industries", key: "industries" },
  { href: withBase("/about"), label: "About", key: "about" },
  { href: withBase("/contact"), label: "Contact", key: "contact" },
];
---

<header class="site-header">
  <div class="wrap">
    <a href={withBase("/")} class="logo">
      <span class="logo-mark"></span>
      CausewayAI
    </a>
    <nav class="main-nav" id="main-nav">
      {links.map((link) => (
        <a href={link.href} aria-current={current === link.key ? "page" : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
    <a href={withBase("/contact")} class="btn btn-primary header-cta">Get in touch</a>
    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
      <span></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("main-nav");
  toggle?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(!!isOpen));
  });
</script>
