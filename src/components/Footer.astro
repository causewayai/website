---
import { withBase } from "../lib/url";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a href={withBase("/")} class="logo">
          <span class="logo-mark"></span>
          CausewayAI
        </a>
        <p style="color: var(--slate-200); opacity: 0.85; max-width: 40ch; margin-top: 12px;">
          Forward-deployed AI engineering for enterprises that can't afford to get it wrong.
        </p>
      </div>
      <div>
        <h4>Company</h4>
        <a href={withBase("/services")}>Services</a>
        <a href={withBase("/industries")}>Industries</a>
        <a href={withBase("/about")}>About</a>
        <a href={withBase("/contact")}>Contact</a>
      </div>
      <div>
        <h4>Get in touch</h4>
        <a href="mailto:hello@causewayai.com">hello@causewayai.com</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {year} CausewayAI. All rights reserved.</span>
      <span>25 years of enterprise engineering experience.</span>
    </div>
  </div>
</footer>
