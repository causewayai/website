---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../lib/url";
import { industries } from "../lib/industries";
---

<Layout
  title="Industries"
  description="25 years of enterprise engineering experience across Pharma, Life Sciences, Financial Services, Insurance, Retail, Cybersecurity, and Hospitality."
  current="industries"
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Industries</p>
      <h1>25 years of experience in the industries where getting it wrong is expensive.</h1>
      <p class="lead">
        We've spent our careers inside regulated, high-stakes, operationally complex businesses.
        That background shapes every AI engagement we take on — we design for the constraints
        your industry actually has, not the ones a generic playbook assumes.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="grid grid-2">
        {industries.map((ind) => (
          <div class="card">
            <h3>{ind.name}</h3>
            <p>{ind.longBlurb}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="cta-band">
        <h2>Don't see your industry?</h2>
        <p>
          Our engineering practices transfer across regulated and operationally complex
          businesses well beyond this list. Tell us about your environment.
        </p>
        <div class="hero-actions">
          <a href={withBase("/contact")} class="btn btn-accent">Get in touch</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
