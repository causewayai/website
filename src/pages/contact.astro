---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact"
  description="Get in touch with CausewayAI to talk about forward-deployed AI engineering support for your business."
  current="contact"
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Contact</p>
      <h1>Let's talk about where you're stuck.</h1>
      <p class="lead">
        Whether you're evaluating AI for the first time or trying to get a stalled pilot into
        production, tell us what's going on and we'll tell you honestly whether we can help.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="contact-grid">
        <div class="contact-card">
          <h3>Email us</h3>
          <p>
            The fastest way to reach us. Tell us a bit about your business, your industry, and
            what you're trying to accomplish with AI.
          </p>
          <a href="mailto:hello@causewayai.com?subject=AI%20Engineering%20Inquiry" class="btn btn-accent">
            hello@causewayai.com
          </a>
        </div>
        <div class="contact-card">
          <h3>What to include</h3>
          <ul style="color: var(--slate-600); padding-left: 20px; margin: 0;">
            <li style="margin-bottom: 10px;">A short description of your business and industry</li>
            <li style="margin-bottom: 10px;">Where you are today — exploring, piloting, or stuck in production</li>
            <li style="margin-bottom: 10px;">The outcome you're trying to reach</li>
            <li style="margin-bottom: 10px;">Any timeline or constraints we should know about</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>
